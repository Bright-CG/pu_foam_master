# Standard Frappe App Gitignore
__pycache__/
*.pyc
.DS_Store
*.swp
*.pyo
*.pyd
.project
.pydevproject
.settings/
.vscode/
.idea/
*.egg-info/
.cursor/
.coa_venv/

# User requested exclusions
*.docx
*.png
*.jpg
*.jpeg
*.rtf
command.txt
Account.csv
Clean_Account.csv

# Factory / client import dumps — never commit live company data
Chart_of_Accounts*.csv
Item_Import*.csv
*_Import.csv
*SolarFoam*
*HappiFoam*
*Happifoam*

# Backups
*_backup*
backup/

# Legacy ERP Archive — code is tracked; runtime data and secrets are not
legacy_erp_archive/data/
legacy_erp_archive/scraper/.venv/
legacy_erp_archive/venv/
legacy_erp_archive/scraper/.env
legacy_erp_archive/laravel_archive/.env
legacy_erp_archive/laravel_archive/vendor/
legacy_erp_archive/laravel_archive/node_modules/

# Specific files identified as unnecessary
New module by module now.txt
Production_Module_Final.txt
UpdatePromptForTheDensityConfigDoctype.txt
Version restoration walkthrough.md
fix_libs/
CodesFromClaude/

# DO NOT IGNORE these essential files (even if they match patterns above)
!modules.txt
!requirements.txt
!MANIFEST.in
!setup.py
!README.md
!walkthrough today.md
!pu_foam_master/
!fake_gunicorn.sh
