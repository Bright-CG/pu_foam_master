# Standard Frappe App Gitignore
__pycache__/
*.pyc
.DS_Store
*.swp
*.pyo
*.pyd
.project
.pydevproject
.settings/
.vscode/
.idea/
*.egg-info/
.cursor/
.coa_venv/

# User requested exclusions
*.docx
*.png
*.jpg
*.jpeg
*.rtf
command.txt
Account.csv
Clean_Account.csv

# Backups
*_backup*
backup/

# Specific files identified as unnecessary
New module by module now.txt
Production_Module_Final.txt
UpdatePromptForTheDensityConfigDoctype.txt
Version restoration walkthrough.md
fix_libs/
CodesFromClaude/

# DO NOT IGNORE these essential files (even if they match patterns above)
!modules.txt
!requirements.txt
!MANIFEST.in
!setup.py
!README.md
!walkthrough today.md
!pu_foam_master/
!fake_gunicorn.sh
