# Standard Frappe App Gitignore
__pycache__/
*.pyc
.DS_Store
*.swp
*.pyo
*.pyd
.project
.pydevproject
.settings/
.vscode/
.idea/
*.egg-info/
.cursor/
.coa_venv/

# User requested exclusions
*.docx
*.png
*.jpg
*.jpeg
*.rtf
command.txt
Account.csv
Clean_Account.csv

# Factory / client import dumps — never commit live company data
Chart_of_Accounts*.csv
Item_Import*.csv
*_Import.csv
*SolarFoam*
*HappiFoam*
*Happifoam*

# Backups
*_backup*
backup/

# Legacy ERP archive — local/VPS tooling only (not part of bench app install)
legacy_erp_archive/

# Doc / note formats not tracked in this repo
*.rst

# Root-level legacy ERP scrape and investigation artifacts
all_customers_export.csv
customer_*.html
select_customer.html
/fetch_samples.py
/inspect_*.py
/test_ar_and_search.py
/test_customer_inquiry.py
/test_cutover.py

# Ad-hoc bench debug helpers
pu_foam_master/**/_bench_*.py

# Specific files identified as unnecessary
New module by module now.txt
Production_Module_Final.txt
UpdatePromptForTheDensityConfigDoctype.txt
Version restoration walkthrough.md
fix_libs/
CodesFromClaude/

# DO NOT IGNORE these essential files (even if they match patterns above)
!modules.txt
!requirements.txt
!MANIFEST.in
!setup.py
!README.md
!walkthrough today.md
!pu_foam_master/
!fake_gunicorn.sh
