APP_NAME="Happifoam Legacy ERP Archive"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Use 8090 — port 8000 is reserved for PU Foam ERPNext (Docker).
APP_URL=http://127.0.0.1:8090

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/legacy_erp_archive/data/happifoam.db

SESSION_DRIVER=file
SESSION_LIFETIME=480

# Single archive user (read-only viewer)
AUTH_ARCHIVE_USER=admin
AUTH_ARCHIVE_PASS=change-me-strong-password
