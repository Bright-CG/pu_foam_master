# Copy to laravel_archive/.env on VPS (user happifoam)

APP_NAME="Happifoam Legacy ERP Archive"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://olderp.happifoam.com

DB_CONNECTION=sqlite
DB_DATABASE=/home/happifoam/olderp/data/happifoam.db

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=true

AUTH_ARCHIVE_USER=admin
AUTH_ARCHIVE_PASS=change-me-strong-password
